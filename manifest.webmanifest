{
  "name": "我的財務回報簿",
  "short_name": "財務回報簿",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f3ee",
  "theme_color": "#6f7f73",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-invoice",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "invoice",
          "accept": [
            "text/csv",
            ".csv",
            "text/comma-separated-values",
            "application/vnd.ms-excel"
          ]
        }
      ]
    }
  }
}